{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignorePatterns": [
    "scratch/**",
    "scripts/**",
    "supabase/**",
    ".agents/**",
    "src/data/pokemon/pokemonDB.ts",
    "src/logic/battle/showdown.worker.ts",
    "src/logic/render/MapRenderer.ts",
    "src/logic/render/render.worker.ts",
    "test aventura/**",
    "public/test-aventura-animations.css",
    "pokemon-showdown-code/**"
