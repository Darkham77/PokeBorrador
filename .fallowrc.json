    "minOccurrences": 2,
    "minLines": 20,
    "minTokens": 120
  },
  "ignoreDependencies": [
    "postgres",
    "@pkmn/sim",
    "eslint-formatter-codeframe",
    "css-checker-kit",
    "@rolldown/binding-wasm32-wasi"
