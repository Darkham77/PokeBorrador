  "entry": [
    "src/index.{ts,tsx,js,jsx}",
    "src/main.{ts,tsx,js,jsx}"
  ],
  "duplicates": {
    "minOccurrences": 2,
    "minLines": 20,
    "minTokens": 120
  },
  "ignoreDependencies": [
    "postgres",
    "@pkmn/sim"
  ],
  "rules": {
    "unused-dependencies": "warn"
  },
