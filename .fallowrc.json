{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignorePatterns": [
    "backup_legacy_code/**",
    "showdown/**",
    "scratch/**",
    "scripts/**",
    "supabase/**",
    ".agents/**"
  ],
  "entry": [
    "src/index.{ts,tsx,js,jsx}",
    "src/main.{ts,tsx,js,jsx}"
  ],
  "duplicates": {
    "minOccurrences": 3
  },
  "rules": {
    "unused-dependencies": "warn"
  },
  "ignoreExports": [
    {
      "file": "src/logic/pokedexConstants.ts",
      "exports": ["POKEDEX_SPECIES_COUNT", "MAX_POKEDEX_ID", "GENERATION_COUNTS", "REGIONAL_POKEDEX_COUNT"]
    },
    {
      "file": "src/logic/pvp/rankedEngine.ts",
      "exports": ["RANKED_TIER_ORDER"]
    },
    {
      "file": "src/stores/inventory.ts",
      "exports": ["Item"]
    },
    {
      "file": "src/data/items.ts",
      "exports": ["MARKET_UNLOCKS"]
    },
    {
      "file": "src/data/trainer.ts",
      "exports": ["MARKET_UNLOCKS"]
    },
    {
      "file": "src/logic/breeding/missionEngine.ts",
      "exports": ["DaycareMission"]
    },
    {
      "file": "src/logic/battle/orchestrator.ts",
      "exports": ["*"]
    },
    {
      "file": "src/types/stores.ts",
      "exports": ["*"]
    },
    {
      "file": "src/data/pokedex.ts",
      "exports": ["*"]
    },
    {
      "file": "src/logic/battle/actions/statusActions.ts",
      "exports": ["*"]
    },
    {
      "file": "src/types/battle.ts",
      "exports": ["*"]
    },
    {
      "file": "src/data/spriteMapping.ts",
      "exports": ["*"]
    },
    {
      "file": "src/stores/map.ts",
      "exports": ["*"]
    },
    {
      "file": "src/stores/ui.ts",
      "exports": ["*"]
    },
    {
      "file": "src/logic/events/eventEngine.ts",
      "exports": ["*"]
    },
    {
      "file": "src/logic/war/warEngine.ts",
      "exports": ["*"]
    }
  ]
}
