# Dockerfile - Poké Vicio Database (CLEAN START)
FROM supabase/postgres:15.1.0.147

# 1. LIMPIEZA RADICAL DE LA IMAGEN BASE
# Borramos los scripts de inicialización que trae Supabase por defecto 
# para evitar que corra 'migrate.sh' y de errores de socket/permisos.
USER root
RUN rm -rf /docker-entrypoint-initdb.d/*

# 2. Infraestructura de Supabase (Nuestros Cimientos)
COPY ./supabase/scripts/init/*.sql /docker-entrypoint-initdb.d/

# 3. Lógica del Juego (Estructura y Evolución)
COPY ./database/schemas /game-schemas/
COPY ./database/migrations /migrations/

# 4. Orquestador
COPY ./supabase/scripts/setup.sh /usr/local/bin/setup-system.sh
RUN chmod +x /usr/local/bin/setup-system.sh

# Volvemos al usuario postgres por seguridad
USER postgres
