{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo/tsconfig.tsbuildinfo",
    "composite": false,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@/styles/*": ["./src/styles/*"],
      "@fgp/auditor": ["./packages/auditor/src/index.ts"],
      "@fgp/auditor/*": ["./packages/auditor/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "scripts/**/*.ts", "packages/**/*.ts", "tests/**/*.ts", "tests/**/*.tsx", "vite.config.ts", "ui-demo/**/*.ts", "ui-demo/**/*.vue"],
  "exclude": []
}
