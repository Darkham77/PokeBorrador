<script>
    var style_dropdown = document.getElementById("style");
    style_dropdown.onchange = function() {
        document.forms["change"].submit();
    };
</script>

<script>
/*
Get the menu to behave.

In the CSS, #menu:hover gets height:100% so that it can provide scrolling if the actual menus are taller than the user's screen. However, this means that after the actual menu has closed, #menu still covers the entire page, is still being hovered over, and prevents clicking on anything underneath it.

All we have to do to fix this is ensure that when we exit the #menu-inner element (the menu proper), we momentarily set #menu's height to auto and then remove the height again. This causes the #menu element to just correctly go back to its unhovered state.
*/
var menu = document.getElementById("menu");
var menu_inner = document.getElementById("menu-inner");
menu_inner.onmouseout = function(e) {
    // Check whether we've actually hovered out of the #menu-inner onto #menu
    if (!e) var e = window.event;
    if (menu.style.position !== "fixed") {
        return;
    }
    var reltg = (e.relatedTarget) ? e.relatedTarget : e.toElement;
    if (reltg == menu) {
        menu.style.height = "auto";
        window.setTimeout(function() { menu.removeAttribute("style"); }, 10);
    }
};

menu_inner.onmouseover = function(e) {
    var menuPos = menu.getBoundingClientRect();
    if (menuPos.top + window.pageYOffset > 0 || menuPos.left + window.pageXOffset > 0 || menu.style.position === "fixed") {
        return;
    }

    if (e.target !== menu_inner) {
        if (e.target.nodeName === 'LI') {
            e.target.className = "over";
        } else if (e.target.nodeName == 'A') {
            e.target.parentNode.className = "over";
        }
    }
    menu.className = "over";
};

document.body.onclick = function(e) {
    var menuPos = menu.getBoundingClientRect();
    if (menuPos.top + window.pageYOffset > 0 || menuPos.left + window.pageXOffset > 0 || menu.style.position === "fixed") {
        return;
    }

    if (e.target === menu_inner || e.target === menu) {
        menu.className = "over";
    }

    var curTarget = e.target;
    // Return if we're within the menu.
    while (curTarget) {
        curTarget = curTarget.parentNode;
        if (curTarget === menu_inner) {
            if (e.target.nodeName === 'A' && e.target.parentNode.children.length > 1) {
                e.target.parentNode.className = "over";
                return false;
            }
            return true;
        }
    }

    if (menu.className === "over") {
        menu.className = "";
    }
    return true;
};
</script>


