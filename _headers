# Static Web Server / CDN Cache-Control Headers

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0

/version.json
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0

/index.html
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0

/assets/*
  Cache-Control: public, max-age=31536000, immutable
