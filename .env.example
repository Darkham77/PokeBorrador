# ------------------------------------------------------------------------------
# POKÉ VICIO - CONFIGURACIÓN UNIFICADA (.env)
# GENERADOR DE CLAVES: https://supabase.com/docs/guides/self-hosting/docker
# ------------------------------------------------------------------------------

# === [ SEGURIDAD Y LLAVES ] ===
# Generar con: openssl rand -base64 32

# === [ RUTA DEL PROYECTO EN EL SERVIDOR ] ===
# Define la ruta absoluta donde se encuentra el proyecto en tu servidor/NAS
# Ej: /share/Software/pokevicio
PROJECT_ROOT=/share/Software/pokevicio-db

# === [ PERSONALIZACIÓN DE IMÁGENES DOCKER ] ===
# Configura estas variables para usar tus propias imágenes de Docker Hub
DOCKER_USER=tu-usuario-dockerhub
DOCKER_REPO_DB=pokevicio-db
DOCKER_TAG_DB=latest

# === [ CLIENTE VITE ] ===
# Estas variables son las que usa el código frontend del juego
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_KEY=tu-anon-key-de-supabase-va-aqui

# === [ BASE DE DATOS (POSTGRES) ] ===
POSTGRES_PORT=54322
# openssl rand -hex 24
POSTGRES_PASSWORD=super-secret-password-pokevicio

# === [ API GATEWAY (KONG) ] ===
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# === [ ENTORNO GRÁFICO (STUDIO) ] ===
# Acceso vía navegador: http://localhost:3000
STUDIO_PORT=3000

# === [ SEGURIDAD Y LLAVES ] ===
# IMPORTANTE: Genera llaves largas y aleatorias. 
# Comando recomendado: openssl rand -base64 32

# Secreto para firmar tokens JWT (Genera uno con: openssl rand -base64 32)
JWT_SECRET=super-secret-jwt-token-must-be-long-and-random-77

# Secreto para el sistema de tiempo real (Realtime)
SECRET_KEY_BASE=un-secreto-muy-largo-y-aleatorio-para-realtime-77

# Llaves de API de Supabase (Deben ser JWT firmados con el JWT_SECRET)
# Consulta la receta de generación en: supabase/docs/DESPLIEGUE_SERVIDOR.md
ANON_KEY=tu-anon-key-generada-con-node-js
SERVICE_ROLE_KEY=tu-service-role-key-generada-con-node-js

# === [ CONECTIVIDAD Y SITIO ] ===
# URL pública donde escucha Kong (Backend)
API_EXTERNAL_URL=http://localhost:8000

# URL de la web / cliente (Frontend)
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=

# === [ AUTENTICACIÓN ] ===
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true

# === [ CONFIGURACIÓN SMTP (EMAIL) ] ===
SMTP_ADMIN_EMAIL=admin@pokevicio.io
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-usuario@gmail.com
SMTP_PASS=tu-password-app
SMTP_SENDER_NAME=Poké Vicio Online

# === [ ADMINISTRACIÓN ] ===
# Una vez registrado, puedes convertir tu cuenta en admin ejecutando:
# Windows: .\supabase\scripts\set-admin.ps1 -Email tu@email.com
# Linux:   ./supabase/scripts/set-admin.sh tu@email.com
