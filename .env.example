# ==============================================================================
# POKÉ VICIO - CONFIGURACIÓN MAESTRA DE SERVIDORES (.env)
# ==============================================================================
# Este archivo es el "Master". El orquestador `setup_supabase.ts` lo usa para:
# 1. Generar archivos .env individuales en supabase/generated/ (para copiar al servidor)
# 2. Construir la imagen Docker para Docker Hub
# ==============================================================================

# --- [ CONFIGURACIÓN GLOBAL DOCKER HUB ] ---
# Usado para build/push de la imagen personalizada
DOCKER_USER=tu-usuario-dockerhub
DOCKER_REPO_DB=pokevicio-db
DOCKER_TAG_DB=latest

# --- [ SERVIDOR: EJEMPLO-LOCAL ] ---
# El comando `generar` producirá `generated/ejemplo-local.env` sin el prefijo `SERVER_ejemplo-local_`
SERVER_ejemplo-local_ID=srv-ejemplo-local
SERVER_ejemplo-local_NAME="Servidor Ejemplo Local"
SERVER_ejemplo-local_REGION="Desarrollo"
SERVER_ejemplo-local_TENANT_ID=your-tenant-id
SERVER_ejemplo-local_SUPABASE_PUBLIC_URL=http://localhost:8000
SERVER_ejemplo-local_API_EXTERNAL_URL=http://localhost:8000
SERVER_ejemplo-local_SITE_URL=http://localhost:3000
SERVER_ejemplo-local_DASHBOARD_USERNAME=supabase
SERVER_ejemplo-local_DASHBOARD_PASSWORD=mipassword123

# El orquestador generará automáticamente las siguientes claves si no las definís:
# SERVER_ejemplo-local_POSTGRES_PASSWORD=
# SERVER_ejemplo-local_JWT_SECRET=
# SERVER_ejemplo-local_ANON_KEY=
# SERVER_ejemplo-local_SERVICE_ROLE_KEY=
# SERVER_ejemplo-local_SECRET_KEY_BASE=
# SERVER_ejemplo-local_VAULT_ENC_KEY=
# SERVER_ejemplo-local_PG_META_CRYPTO_KEY=
# ... etc

# --- [ SERVIDOR: nas-franco ] ---
# Ejemplo de configuración para QNAP NAS con HTTPS y puerto KONG alternativo para evitar colisiones
SERVER_nas-franco_ID=nas-franco
SERVER_nas-franco_NAME="Franco NAS (Docker)"
SERVER_nas-franco_REGION="Desarrollo"
SERVER_nas-franco_TENANT_ID=your-tenant-id
SERVER_nas-franco_SUPABASE_PUBLIC_URL=https://tu-dominio.myqnapcloud.com:8443
SERVER_nas-franco_API_EXTERNAL_URL=https://tu-dominio.myqnapcloud.com:8443
SERVER_nas-franco_SITE_URL=http://localhost:5173
SERVER_nas-franco_DASHBOARD_USERNAME=admin
SERVER_nas-franco_DASHBOARD_PASSWORD=otra-password-segura
SERVER_nas-franco_KONG_HTTPS_PORT=8444

# ==============================================================================
# NOTA: No edites manualmente las claves criptográficas si no es necesario.
# Corré `npm run supabase:manage generate` y el orquestador las creará por vos.
# ==============================================================================
