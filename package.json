{
  "name": "pokemon-online",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.4.0"
  },
  "scripts": {
    "preinstall": "node -e \"if(parseInt(process.versions.node.split('.')[0]) < 26) console.warn('\\n\\x1b[33m\\x1b[1m⚠️ ATENCIÓN: Se recomienda Node.js v26 o superior para este proyecto.\\n🔗 Descárgalo aquí: https://nodejs.org/es/download/current\\nTu versión es v' + process.versions.node + '\\x1b[0m\\n')\"",
    "dev": "node -e \"if(process.platform === 'win32') try { require('child_process').execSync('chcp 65001') } catch (e) {}\" && vite",
    "build": "npm run db:sync && npm run validate:types && npm run audit:full && vite build",
    "preview": "vite preview",
    "admin:rename": "node --env-file=.env --permission --experimental-strip-types --allow-fs-read=. --allow-fs-write=. --allow-env scripts/maintenance/admin_rename.ts",
    "validate:types": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:node": "node --experimental-strip-types --experimental-test-coverage --test \"tests/node/**/*.test.ts\"",
    "test:all": "npm run test:node && npm run test",
    "test:move-coverage": "vitest run tests/unit/battle/coverage_fuzzer.spec.ts",
    "lint": "npm run validate:types && eslint . --fix && npm run lint:md",
    "lint:analyze": "eslint . -f json -o lint-results.json || node analyze_lint.cjs",
    "lint:md": "markdownlint \"**/*.md\" --ignore \"node_modules/**\" --ignore \"dist/**\" --ignore \"dev-dist/**\" --ignore \"backup_legacy_code/**\" --ignore \"supabase/**\" --ignore \"docs/media/**\" --ignore \"scratch/**\" --fix",
    "servers:configure": "node --permission --experimental-strip-types --allow-fs-read=. --allow-fs-write=. scripts/maintenance/configure_official_servers.ts",
    "servers:db:update": "node --permission --experimental-strip-types --allow-fs-read=. --allow-net scripts/database/update_supabase_db.ts",
    "servers:db:backup": "node --permission --experimental-strip-types --allow-fs-read=. --allow-fs-write=. --allow-net scripts/database/backup_supabase_db.ts",
    "servers:db:restore": "node --permission --experimental-strip-types --allow-fs-read=. --allow-net scripts/database/restore_supabase_db.ts",
    "servers:db:local-import": "node --permission --experimental-strip-types --allow-fs-read=. --allow-fs-write=. scripts/database/import_backup_to_sqlite.ts",
    "servers:db:admin": "node --permission --experimental-strip-types --allow-fs-read=. --allow-net scripts/maintenance/admin_supabase_users.ts",
    "supabase:manage": "node --permission --experimental-strip-types --allow-fs-read=. --allow-fs-write=. --allow-child-process supabase/setup_supabase.ts",
    "migrations:generate": "node --permission --experimental-strip-types --allow-fs-read=. --allow-fs-write=. scripts/database/generate_migrations.ts",
    "validate:sql": "node --permission --experimental-strip-types --allow-fs-read=. --allow-fs-write=. scripts/database/validate_sql_migrations.ts",
    "assets:download": "node --permission --experimental-strip-types --allow-fs-read=. --allow-fs-write=. --allow-net=raw.githubusercontent.com,play.pokemonshowdown.com scripts/assets/download_assets.ts",
    "assets:convert": "node --permission --experimental-strip-types --allow-worker --allow-addons --allow-fs-read=. --allow-fs-write=. scripts/assets/convert_assets.ts",
    "audit": "node --permission --experimental-strip-types --allow-fs-read=. --allow-fs-write=. --allow-child-process scripts/maintenance/audit_project.ts",
    "audit:changed": "npm run audit -- --changed-since main",
    "audit:warnings-diff": "node --permission --experimental-strip-types --allow-fs-read=* --allow-fs-write=* --allow-child-process scripts/maintenance/audit_warnings_diff.ts",
    "audit:fix": "node --permission --experimental-strip-types --allow-fs-read=. --allow-fs-write=. --allow-child-process scripts/maintenance/audit_project.ts --fix",
    "audit:summary": "npm run audit -- --summary",
    "audit:errors": "npm run audit -- --errors-only",
    "audit:report": "npm run audit -- --output=scratch/audit_report.txt",
    "audit:fallow:fix": "npx fallow fix",
    "audit:fallow:summary": "npx fallow --summary",
    "audit:fallow:report": "npx fallow --format human > scratch/fallow_report.txt",
    "audit:fallow:triplets": "npx fallow dupes --min-occurrences 3 --min-lines 10 --min-tokens 60",
    "audit:full": "node --permission --experimental-strip-types --allow-fs-read=* --allow-fs-write=* --allow-child-process scripts/maintenance/audit_full.ts",
    "validate:fsm:diagrams": "node --permission --experimental-strip-types --allow-fs-read=. --allow-fs-write=. scripts/validation/validate_fsm_diagrams.ts",
    "validate:fsm:implementation": "node --permission --experimental-strip-types --allow-fs-read=. --allow-fs-write=. scripts/validation/validate_fsm_implementation.ts",
    "validate:fsm:flow": "node --permission --experimental-strip-types --allow-fs-read=. --allow-fs-write=. scripts/validation/validate_fsm_flow_parity.ts",
    "validate:fsm": "node --permission --experimental-strip-types --allow-fs-read=. --allow-child-process scripts/validation/validate_fsm_all.ts",
    "validate:items": "node --permission --experimental-strip-types --allow-fs-read=. --allow-fs-write=. scripts/validation/validate_items.ts",
    "validate:items:summary": "npm run validate:items -- --summary",
    "validate:items:errors": "npm run validate:items -- --errors-only",
    "validate:items:report": "npm run validate:items -- --output=scratch/items_report.txt",
    "validate:abilities": "node --permission --experimental-strip-types --allow-fs-read=. --allow-fs-write=. scripts/validation/validate_abilities.ts",
    "validate:abilities:summary": "npm run validate:abilities -- --summary",
    "validate:abilities:errors": "npm run validate:abilities -- --errors-only",
    "validate:abilities:report": "npm run validate:abilities -- --output=scratch/abilities_report.txt",
    "validate:moves": "node --permission --experimental-strip-types --allow-fs-read=. --allow-fs-write=. scripts/validation/validate_moves.ts",
    "validate:moves:summary": "npm run validate:moves -- --summary",
    "validate:moves:errors": "npm run validate:moves -- --errors-only",
    "validate:moves:report": "npm run validate:moves -- --output=scratch/moves_report.txt",
    "validate:pokemon": "node --permission --experimental-strip-types --allow-fs-read=. --allow-fs-write=. scripts/validation/validate_pokemon.ts",
    "validate:pokemon:summary": "npm run validate:pokemon -- --summary",
    "validate:pokemon:errors": "npm run validate:pokemon -- --errors-only",
    "validate:pokemon:report": "npm run validate:pokemon -- --output=scratch/pokemon_report.txt",
    "validate:sprites": "node --permission --experimental-strip-types --allow-fs-read=. --allow-fs-write=. scripts/validation/validate_sprites.ts",
    "validate:sprites:summary": "npm run validate:sprites -- --summary",
    "validate:sprites:errors": "npm run validate:sprites -- --errors-only",
    "validate:sprites:report": "npm run validate:sprites -- --output=scratch/sprites_report.txt",
    "validate:sandbox": "node --permission --experimental-strip-types --allow-fs-read=. --allow-fs-write=. scripts/validation/validate_sandbox_moves_tooltip.ts",
    "validate:sandbox:summary": "npm run validate:sandbox -- --summary",
    "validate:sandbox:errors": "npm run validate:sandbox -- --errors-only",
    "validate:sandbox:report": "npm run validate:sandbox -- --output=scratch/sandbox_report.txt",
    "validate:translations": "node --permission --experimental-strip-types --allow-fs-read=. --allow-fs-write=. scripts/validation/validate_translations.ts",
    "validate:fsm:summary": "npm run validate:fsm:implementation -- --summary",
    "validate:fsm:errors": "npm run validate:fsm:implementation -- --errors-only",
    "validate:fsm:report": "npm run validate:fsm:implementation -- --output=scratch/fsm_report.txt",
    "sync:test": "node --experimental-strip-types scripts/maintenance/sync_to_test.ts",
    "db:sync": "node --permission --experimental-strip-types --allow-fs-read=. --allow-fs-write=. scripts/maintenance/sync_db_with_showdown.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "@types/gsap": "^1.20.2",
    "gsap": "^3.15.0",
    "pinia": "^2.3.1",
    "valibot": "^1.4.1",
    "vue": "^3.5.32",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@pkmn/sim": "^0.10.9",
    "@types/node": "^25.6.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.9",
    "eslint": "^9.21.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^9.33.0",
    "fallow": "^2.88.2",
    "globals": "^15.15.0",
    "jsdom": "^26.0.0",
    "markdownlint-cli": "^0.49.0",
    "postgres": "^3.4.9",
    "sass": "^1.99.0",
    "sharp": "^0.34.5",
    "sql.js": "^1.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  }
}
