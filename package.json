{
  "name": "pokemon-online",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "imports": {
    "@/*": "./src/*"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "preinstall": "node -e \"if(parseInt(process.versions.node.split('.')[0]) < 26) console.warn('\\n\\x1b[33m\\x1b[1m⚠️ ATENCIÓN: Se recomienda Node.js v26 o superior para este proyecto.\\n🔗 Descárgalo aquí: https://nodejs.org/es/download/current\\nTu versión es v' + process.versions.node + '\\x1b[0m\\n')\"",
    "dev": "chcp 65001 > nul && vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:native": "node --experimental-strip-types --test \"tests/node/**/*.test.ts\"",
    "lint": "npm run type-check && eslint . --fix",
    "lint:analyze": "eslint . -f json -o lint-results.json || node analyze_lint.cjs",
    "generate-migrations": "node --permission --experimental-strip-types --allow-fs-read=. --allow-fs-write=. scripts/generate_migrations.ts",
    "validate-sql": "node --permission --experimental-strip-types --allow-fs-read=. scripts/validate_sql_migrations.ts",
    "download-assets": "node --permission --experimental-strip-types --allow-fs-read=. --allow-fs-write=. --allow-net=raw.githubusercontent.com,play.pokemonshowdown.com scripts/download_assets.ts",
    "convert-assets": "node --permission --experimental-strip-types --allow-addons --allow-fs-read=. --allow-fs-write=. scripts/convert_assets.ts",
    "audit": "node --permission --experimental-strip-types --allow-fs-read=. scripts/audit_project.ts",
    "audit:fix": "node --permission --experimental-strip-types --allow-fs-read=. --allow-fs-write=. scripts/audit_project.ts --fix",
    "audit:full": "npm run audit && npm run fsm:audit && npm run validate:items && npm run validate-sql",
    "fsm:verify": "node --permission --experimental-strip-types --allow-fs-read=. scripts/verify_fsm_diagrams.ts",
    "fsm:audit": "node --permission --experimental-strip-types --allow-fs-read=. scripts/audit_fsm_implementation.ts",
    "fsm:flow": "node --permission --experimental-strip-types --allow-fs-read=. scripts/audit_fsm_flow_parity.ts",
    "validate:items": "node --permission --experimental-strip-types --allow-fs-read=. scripts/validate_items.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@supabase/supabase-js": "^2.103.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.32",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.9",
    "eslint": "^9.21.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.15.0",
    "jsdom": "^26.0.0",
    "sass": "^1.99.0",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^7.3.2",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.0.7",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^3.2.8"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  }
}
